msgstr "Metti in pausa / riprendi audio e video"

msgid "Do nothing"
msgstr "Non fare nulla"

msgid "no shortcut"
msgstr "nessuna scorciatoia"

msgid "Free positioning only works while the widget sits on the desktop."
msgstr "Il posizionamento libero funziona solo se il widget si trova sul desktop."

msgid "Repair"
msgstr "Ripara"

msgid "Don't report again"
msgstr "Non segnalare più"

msgid "Sound of %1 is muted"
msgstr "L’audio di %1 è disattivato"

msgid "The system remembered this app as muted or at 0 %. Click “Repair” to give it its sound back."
msgstr "Il sistema ha memorizzato questa app come muta o allo 0 %. Fai clic su «Ripara» per restituirle l’audio."

msgid "The settings editor could not be loaded."
msgstr "Impossibile caricare l’editor delle impostazioni."

msgid "Lock position"
msgstr "Blocca posizione"

msgid "Move freely"
msgstr "Sposta liberamente"

msgid "Pause playback"
msgstr "Metti in pausa la riproduzione"

msgid "Resume playback"
msgstr "Riprendi la riproduzione"

msgid "No audio capture tool found.\nPlease install “pulseaudio-utils” or “pipewire-utils” (or “cava”) and add the widget again."
msgstr "Nessuno strumento di acquisizione audio trovato.\nInstalla «pulseaudio-utils» o «pipewire-utils» (oppure «cava») e aggiungi di nuovo il widget."

msgid "The audio engine could not be started."
msgstr "Impossibile avviare il motore audio."

msgid "Drag = move · Edges and corners = resize · Wheel = zoom · Arrow keys = 1 px (⇧ 10 px)"
msgstr "Trascina = sposta · Bordi e angoli = ridimensiona · Rotellina = zoom · Frecce = 1 px (⇧ 10 px)"

msgid "Lock (%1 / Enter)"
msgstr "Blocca (%1 / Invio)"

msgid "Configure SeaQ SoundWave…"
msgstr "Configura SeaQ SoundWave…"

msgid "Choose a colour"
msgstr "Scegli un colore"

msgid "Copied to the clipboard"
msgstr "Copiato negli appunti"

msgid "My palette %1"
msgstr "La mia tavolozza %1"

msgid "“%1” saved"
msgstr "«%1» salvata"

msgid "Colour"
msgstr "Colore"

msgid "Remove"
msgstr "Rimuovi"

msgid "Position"
msgstr "Posizione"

msgid "Rotation"
msgstr "Rotazione"

msgid "Type"
msgstr "Tipo"

msgid "Auto: every visualizer lays out the colours itself (e.g. per line, all around or from bottom to top)."
msgstr "Auto: ogni visualizzatore dispone i colori da sé (ad es. per linea, tutt’intorno o dal basso verso l’alto)."

msgid "The gradient covers the whole visualizer – rotation and type apply as set above."
msgstr "Il gradiente copre l’intero visualizzatore – rotazione e tipo valgono come impostato sopra."

msgid "Random"
msgstr "Casuale"

msgid "Save"
msgstr "Salva"

msgid "Name of the palette"
msgstr "Nome della tavolozza"

msgid "Cancel"
msgstr "Annulla"

msgid "Preview with the current visualizer"
msgstr "Anteprima con il visualizzatore attuale"

