msgstr "Gefunden: Taskleiste unten."

msgid "Found: panel at the top."
msgstr "Gefunden: Taskleiste oben."

msgid "Found: panel on the left."
msgstr "Gefunden: Taskleiste links."

msgid "Found: panel on the right."
msgstr "Gefunden: Taskleiste rechts."

