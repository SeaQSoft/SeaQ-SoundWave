msgstr "Options du style"

msgid "Adapts to the selected style"
msgstr "S’adapte au style choisi"

msgid "Colours"
msgstr "Couleurs"

msgid "Colour collection and gradient editor"
msgstr "Collection de couleurs et éditeur de dégradés"

msgid "In the widget, at the panel, fixed or free"
msgstr "Dans le widget, au tableau de bord, fixe ou libre"

msgid "Behaviour"
msgstr "Comportement"

msgid "Orb & playback"
msgstr "Sphère et lecture"

msgid "The orb in the middle – a click pauses"
msgstr "La sphère au milieu – un clic met en pause"

